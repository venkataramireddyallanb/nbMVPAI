# nicheBrains backend env vars — copy to `.env` for local dev.

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_SECRET_KEY=change-me-too-and-make-it-different-from-secret-key

# --- Database ---
# SQLite for dev; switch to postgresql://user:pass@host:5432/nichebrains for prod.
DATABASE_URL=sqlite:///nichebrains.db

# --- CORS ---
CORS_ORIGINS=http://localhost:4200

# --- LLM / CrewAI ---
# Required for the two production LLM agents (Narrator, Instant-Report Drafter).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Auth ---
ACCESS_TOKEN_EXPIRES_MIN=30
REFRESH_TOKEN_EXPIRES_DAYS=14
BCRYPT_LOG_ROUNDS=12

# --- App ---
APP_NAME=nicheBrains
APP_VERSION=5.0.0
PEER_BENCHMARK_MIN_COHORT=10
AUDIT_LOG_RETENTION_YEARS=7
